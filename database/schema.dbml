Table parking_spots {
  id integer [pk, increment]
  spot_code varchar(10) [not null, note: 'Space code on this level, such as A-01']
  floor integer [not null]
  sector varchar(5) [not null]
  status varchar(20) [not null, default: 'free', note: 'free or occupied']
  x_coord real [not null]
  y_coord real [not null]
  created_at datetime [not null]
  updated_at datetime

  indexes {
    (floor, spot_code) [unique, name: 'uq_parking_spot_floor_code']
    spot_code [name: 'ix_parking_spots_spot_code']
    floor [name: 'ix_parking_spots_floor']
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParkingSpotContract",
  "description": "A parking space returned by the map API.",
  "type": "object",
  "required": [
    "id",
    "spot_code",
    "floor",
    "sector",
    "status",
    "coordinates",
    "led_indicator"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer"
    },
    "spot_code": {
      "type": "string",
      "examples": [
        "A-01"
      ]
    },
    "floor": {
      "type": "integer",
      "examples": [
        1
      ]
    },
    "sector": {
      "type": "string",
      "examples": [
        "A"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "free",
        "occupied"
      ]
    },
    "coordinates": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "led_indicator": {
      "type": "object",
      "required": [
        "color",
        "hex_color",
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "string",
          "enum": [
            "green",
            "red"
          ]
        },
        "hex_color": {
          "type": "string",
          "examples": [
            "#22C55E"
          ]
        },
        "mode": {
          "const": "steady"
        }
      }
    },
    "last_telemetry_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SensorTelemetryContract",
  "description": "An occupancy update sent by a sensor controller.",
  "request": {
    "endpoint": "POST /api/v1/telemetry/sensor-event",
    "headers": {
      "Content-Type": "application/json"
    },
    "payload": {
      "type": "object",
      "required": [
        "device_id",
        "spot_code",
        "distance_cm",
        "raw_state",
        "is_occupied",
        "timestamp"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "examples": [
            "ESP32_NODE_A01"
          ]
        },
        "spot_code": {
          "type": "string",
          "examples": [
            "A-01"
          ]
        },
        "floor": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Required when the space code is used on more than one level."
        },
        "distance_cm": {
          "type": "number"
        },
        "raw_state": {
          "type": "integer",
          "enum": [
            0,
            1
          ],
          "description": "0 means free and 1 means occupied."
        },
        "is_occupied": {
          "type": "boolean"
        },
        "timestamp": {
          "type": "integer",
          "description": "Unix timestamp, in seconds."
        }
      }
    }
  },
  "response": {
    "status_200": {
      "type": "object",
      "required": [
        "status",
        "spot_code",
        "led_color",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "success"
        },
        "spot_code": {
          "type": "string"
        },
        "led_color": {
          "type": "string",
          "enum": [
            "green",
            "red"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
